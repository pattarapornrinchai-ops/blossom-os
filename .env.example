# ============================================================
# BLOSSOM OS — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase
# ============================================================

# Supabase — ดูได้ที่: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# (Optional) สำหรับ Server-side เท่านั้น — ไม่ต้องใส่ถ้าไม่ใช้
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
